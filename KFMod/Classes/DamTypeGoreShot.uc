	abstract;

defaultproperties
{
     WeaponClass=Class'KFMod.GoreCannon'
     DeathString="%o was flattened by a flying corpse from %k's Gore Cannon."
     FemaleSuicide="%o was flattened by a corpse."
     MaleSuicide="%o was flattened by a corpse."
}
