//=============================================================================
// The puff where a blade goes in (KFMonster.BloodClassFor): the shot puff made small, as it is seen from
// arm's length.
//=============================================================================
class KFBladeHitPuff extends KFBloodPuff;

defaultproperties
{
     mMaxParticles=3
     mLifeRange(0)=0.350000
     mLifeRange(1)=0.500000
     mSizeRange(0)=4.000000
     mSizeRange(1)=6.000000
     mGrowthRate=14.000000
}
